generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  AUTHOR
}

enum NewsStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum EditorialAuditAction {
  CREATED
  UPDATED
  SUBMITTED_FOR_REVIEW
  RETURNED_TO_DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaOrigin {
  UPLOADED
  AI_GENERATED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  passwordHash String?
  publicSlug String? @unique
  bio       String?
  avatarUrl String?
  isAuthorProfileActive Boolean @default(false)
  role      UserRole @default(AUTHOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdNews  News[] @relation("CreatedBy")
  updatedNews  News[] @relation("UpdatedBy")
  reviewedNews News[] @relation("ReviewedBy")
  publishedNews News[] @relation("PublishedBy")
  assignedAuthoredNews News[] @relation("AssignedAuthor")
  editorialAuditEvents EditorialAuditEvent[]
  createdMediaAssets MediaAsset[]
  linkedNewsMedia NewsMediaAsset[]
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  municipalities Municipality[]
  news           News[]
}

model Municipality {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  stateCode String   @default("RO")
  isActive  Boolean  @default(true)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  news News[]

  @@unique([name, stateCode])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  news News[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  news News[]
}

model News {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  summary        String?
  content        String
  contentBlocks  Json?
  heroImageUrl   String?
  heroImageAlt   String?
  heroImageCaption String?
  heroImageCredit String?
  status         NewsStatus @default(DRAFT)
  isAiAssisted   Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  publishedAt    DateTime?

  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)

  regionId       String?
  region         Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)

  tags Tag[]

  authorId       String?
  author         User? @relation("AssignedAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdById    String
  createdBy      User @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById    String?
  updatedBy      User? @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  reviewedById   String?
  reviewedBy     User? @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  publishedById  String?
  publishedBy    User? @relation("PublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  auditEvents    EditorialAuditEvent[]

  heroMediaAssetId String?
  heroMediaAsset MediaAsset? @relation("HeroMedia", fields: [heroMediaAssetId], references: [id], onDelete: SetNull)
  mediaLinks NewsMediaAsset[]

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([municipalityId, status, publishedAt])
  @@index([authorId, status, publishedAt])
  @@index([heroMediaAssetId])
}

model MediaAsset {
  id               String    @id @default(cuid())
  origin           MediaOrigin
  storageKeyOriginal String  @unique
  storageKeyPublic String    @unique
  mimeType         String
  width            Int
  height           Int
  fileSize         Int
  altText          String?
  caption          String?
  credit           String?
  aiPrompt         String?
  isSensitive      Boolean   @default(false)
  isBlurred        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdById      String
  createdBy        User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  heroOfNews       News[]    @relation("HeroMedia")
  newsLinks        NewsMediaAsset[]

  @@index([origin, createdAt])
  @@index([createdById, createdAt])
}

model NewsMediaAsset {
  id          String   @id @default(cuid())
  newsId      String
  mediaAssetId String
  addedById   String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  news        News      @relation(fields: [newsId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  addedBy     User      @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([newsId, mediaAssetId])
  @@index([newsId, sortOrder])
  @@index([mediaAssetId])
}

model EditorialAuditEvent {
  id         String             @id @default(cuid())
  articleId  String
  article    News               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User               @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     EditorialAuditAction
  fromStatus NewsStatus?
  toStatus   NewsStatus?
  notes      String?
  createdAt  DateTime           @default(now())

  @@index([articleId, createdAt])
  @@index([actorId, createdAt])
}